# Copy this file to .env and fill in at least TELEGRAM_TOKEN.

# Bot token from https://t.me/BotFather (/newbot)
TELEGRAM_TOKEN=123456789:ABC-your-token

# Optional: only these Telegram IDs may use the bot (comma separated, empty = everyone).
# Your ID is shown in the bot under /status.
ALLOWED_USERS=

# Optional
TIMEZONE=Europe/Berlin
POLL_INTERVAL=60
TGTG_PROXY=
